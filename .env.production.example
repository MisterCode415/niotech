# Copy to .env.production on the server and fill in. Never commit the filled-in copy.
# Generate every secret below with: openssl rand -base64 48

# --- Core ---
NODE_ENV=production
API_PORT=4000

# Public hostname. SERVER_NAME configures nginx; WEB_ORIGIN is stamped into QR stickers and
# emailed links, so if it is wrong every printed kit label points at the wrong place.
SERVER_NAME=nio.example.com
WEB_ORIGIN=https://nio.example.com
API_PUBLIC_URL=https://nio.example.com

# --- Database ---
# Managed PostgreSQL reached over a private network. sslmode is mandatory: the API refuses to
# start against a remote host without it, because PHI would otherwise cross the wire in clear.
# Run deploy/create-app-db-role.sql as the administrator first, then use the restricted login here.
# Keep the administrator URL out of this file and export it as MIGRATION_DATABASE_URL only while
# running deploy/deploy.sh.
DATABASE_URL=postgres://nio_app:replace-me@nio-db-xxxx.postgres.database.azure.com:5432/nio?sslmode=require

# To run PostgreSQL in a container next to the app instead of using a managed instance, set
# BUNDLED_DB=true, point DATABASE_URL at the service name, and fill in POSTGRES_PASSWORD.
# You then own backups entirely. See the README.
BUNDLED_DB=false
# POSTGRES_USER=nio
# POSTGRES_DB=nio
# POSTGRES_PASSWORD=
# DATABASE_URL=postgres://nio_app:replace-me@postgres:5432/nio

# --- Auth ---
# dev = tokens issued for any known email with NO PASSWORD. Acceptable only while the IP
# allowlist in deploy/allowlist.conf keeps this deployment private. The API refuses to start
# in production unless ALLOW_DEV_AUTH is explicitly true.
AUTH_PROVIDER=dev
ALLOW_DEV_AUTH=true
DEV_AUTH_SECRET=replace-me

# Switch to AUTH_PROVIDER=auth0 and fill these in to remove the passwordless login entirely.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Platform bootstrap ---
# The alpha superuser. Nothing can be configured until this email signs in.
PLATFORM_ADMIN_EMAIL=you@example.com

# --- Storage (PHI) ---
# Overridden by compose to the nio-storage volume so uploads survive redeploys.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/storage

# --- Email ---
# Azure blocks outbound port 25 from VMs, so a relay on 587 is required. TLS is mandatory for any
# non-local host and credentials are needed unless the relay authorises this server by IP.
# SMTP_FROM must be an address the relay has verified, or it will reject the message.
#
# Azure Communication Services:  run deploy/azure-email.sh, which prints these values.
#   SMTP_HOST=smtp.azurecomm.net   SMTP_USER=<your SMTP username>   SMTP_PASS=<Entra client secret>
# SendGrid:                      SMTP_HOST=smtp.sendgrid.net   SMTP_USER=apikey   SMTP_PASS=<key>
#
# To capture mail instead of sending it, run with --profile mailpit and set SMTP_HOST=mailpit.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NIO Tech <no-reply@example.com>"

# --- Payments ---
PAYMENT_PROVIDER=mock
