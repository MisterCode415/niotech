FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# Both app tsconfigs extend this; without it tsc silently falls back to defaults and fails.
COPY tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --filter @nio/web --filter @nio/shared

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web
# The SPA calls the API with same-origin relative paths, so no API URL is baked in at build time.
RUN pnpm -F @nio/web build

FROM nginx:1.27-alpine AS runtime
RUN rm /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# nginx:alpine renders anything in templates/ through envsubst on startup.
COPY deploy/nginx.conf.template /etc/nginx/templates/nio.conf.template
EXPOSE 80 443
