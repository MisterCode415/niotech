---
const models = [
  {
    label: 'Option A',
    title: 'Sell kits through QiNio',
    lead: "QiNio's fulfillment partner, lab, and clinicians run the stages. Your brand is on the storefront, the emails, and the customer experience.",
    points: [
      'White-labeled storefront and customer portal',
      'Managed fulfillment, lab, and clinician network',
      'You focus on product, marketing, and customers',
    ],
  },
  {
    label: 'Option B',
    title: 'Bring your own fulfillment, lab, and clinicians',
    lead: 'Use your own partners and your own people. QiNio is the software that coordinates them.',
    points: [
      'Invite your fulfillment team, lab, and doctors into role-specific portals',
      'Same tracking, custody, and audit trail as managed stages',
      'Keep your existing partner relationships',
    ],
  },
];
---

<section class="section" id="models">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Two ways to run it</p>
      <h2>Pick how much of the lifecycle QiNio runs</h2>
    </div>

    <div class="grid two">
      {
        models.map((model) => (
          <article class="card">
            <p class="label">{model.label}</p>
            <h3>{model.title}</h3>
            <p class="lead">{model.lead}</p>
            <ul>
              {model.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="note">
      Not all or nothing: the stages are independent, so you can mix them, for example QiNio's lab with
      your own clinicians.
    </p>
  </div>
</section>

<style>
  .two {
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .card {
    padding: 32px;
  }
  .label {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h3 {
    font-size: 1.4rem;
  }
  .lead {
    margin-top: 12px;
    color: var(--ink-soft);
  }
  ul {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    padding: 8px 0 8px 28px;
    border-top: 1px solid var(--line);
  }
  li::before {
    content: '';
    position: absolute;
    top: 16px;
    left: 4px;
    width: 12px;
    height: 7px;
    border-bottom: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .note {
    margin-top: 26px;
    color: var(--ink-soft);
  }
  @media (max-width: 820px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
