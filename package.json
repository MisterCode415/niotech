{
  "name": "nio-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm run db:up && pnpm run db:migrate && pnpm run db:seed && concurrently -n api,web -c cyan,magenta \"pnpm -F @nio/api dev\" \"pnpm -F @nio/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -F @nio/api test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm run db:up && pnpm run db:migrate && pnpm run db:seed",
    "db:generate": "pnpm -F @nio/api db:generate",
    "db:migrate": "pnpm -F @nio/api db:migrate",
    "db:seed": "pnpm -F @nio/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
