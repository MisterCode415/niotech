---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Lifecycle from '../components/Lifecycle.astro';
import Models from '../components/Models.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import Security from '../components/Security.astro';
import Onboarding from '../components/Onboarding.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="QiNio: launch an at-home lab testing brand"
  description="QiNio runs the workflow behind at-home test kits: checkout, fulfillment, lab results, and clinician review, white-labeled for your business."
>
  <Header />
  <main>
    <Hero />
    <Lifecycle />
    <Models />
    <Features />
    <Pricing />
    <Security />
    <Onboarding />
    <ContactForm />
  </main>
  <Footer />
</Base>
