# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgres://nio_app:nio-app-local@localhost:5433/nio
MIGRATION_DATABASE_URL=postgres://nio:nio@localhost:5433/nio

# --- Auth ---
# dev  = local signed tokens, no Auth0 tenant required
# auth0 = real Auth0 (requires the AUTH0_* values below)
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=dev-only-secret-change-me

AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Platform bootstrap ---
# Manually seeded alpha superuser. Nothing else can be done until this email logs in.
PLATFORM_ADMIN_EMAIL=admin@niotech.test

# --- Storage (PHI) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- Email (Mailpit in dev: http://localhost:8025) ---
# Mailpit needs no credentials. A real relay requires SMTP_USER/SMTP_PASS and enforces TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="NIO Tech <no-reply@niotech.test>"
# SMTP_USER=
# SMTP_PASS=

# --- Payments ---
PAYMENT_PROVIDER=mock
